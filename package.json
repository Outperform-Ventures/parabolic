{
  "name": "parabolic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "Open-source issue, project, and planning workspace for macOS and the web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkuechly/Parabolic.git"
  },
  "homepage": "https://github.com/jkuechly/Parabolic#readme",
  "bugs": {
    "url": "https://github.com/jkuechly/Parabolic/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --import tsx src/server/index.ts",
    "build": "vite build && node scripts/build-server.mjs && node scripts/build-desktop.mjs && pnpm --filter @parabolic/sdk build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "start": "node dist-server/index.mjs",
    "desktop": "electron .",
    "package:mac": "pnpm build && electron-builder --config electron-builder.config.cjs --mac dir",
    "mcp": "node dist-mcp/cli.mjs",
    "mcp:http": "node dist-mcp/cli.mjs --http"
  },
  "engines": {
    "node": ">=24.4.0"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "electron-updater": "6.8.9",
    "entities": "7.0.1",
    "graphql": "^17.0.2",
    "happy-dom": "^20.14.0",
    "idb": "^8.0.3",
    "lib0": "^0.2.117",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.41.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "nodemailer": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sanitize-html": "^2.17.7",
    "semver": "^7.8.5",
    "stemmer": "^2.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "ws": "^8.21.3",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "ical.js": "^2.2.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "main": "dist-desktop/main.cjs"
}
